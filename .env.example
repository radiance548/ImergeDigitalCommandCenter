# ------------------------------------------------------------------
# Database (Supabase Postgres)
# From your Supabase project: Settings -> Database -> Connection string.
# DATABASE_URL uses the direct/session connection (port 5432), not the
# transaction-mode pgbouncer pooler (6543) — that pooler can reassign the
# underlying Postgres connection between statements, which breaks Prisma
# interactive transactions ($transaction, used by withRLS on every RLS'd
# query). DIRECT_URL is the same connection, kept separate because
# `prisma migrate` needs it.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Supabase Auth
# From your Supabase project: Settings -> API.
# NEXT_PUBLIC_* values are safe to expose to the browser (and needed
# there); SUPABASE_SERVICE_ROLE_KEY is NOT — server-only, bypasses Row
# Level Security entirely. Never send it to the client.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Your real, public app URL — used by scripts/bootstrapSuperAdmin.ts to
# build the invite link's redirect target (must also be added under
# Authentication -> URL Configuration -> Redirect URLs in the Supabase
# dashboard, or invite/reset links will look fine but fail when clicked).
NEXT_PUBLIC_APP_URL="https://commandcenter.imergedigital.com"

# ------------------------------------------------------------------
# Login rate limiting (Upstash Redis — free tier is enough for this)
# Sign up at upstash.com, create a Redis database, copy these from
# the REST API section. If unset, falls back to an in-memory limiter
# (fine for local dev, not reliable across multiple serverless
# instances in production — see src/lib/server/rateLimit.ts).
# ------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------
# Campaign sending (Plunk Campaigns + transactional API)
# PLUNK_API_KEY is your Plunk SECRET key (sk_...), not the public one.
# PLUNK_WEBHOOK_SECRET is optional — Plunk has no dashboard-configurable
# webhook subscription like Resend's; inbound events only exist as a step
# inside a manually-built Workflow (Plunk's automation feature), verified
# by a shared-secret Authorization: Bearer header you set on that step —
# see the class comment on PlunkMailProvider for details. Leave unset if
# you haven't set one up (nothing in this app requires it to function —
# the Campaign Builder's analytics poll Plunk's stats endpoint instead).
# ------------------------------------------------------------------
PLUNK_API_KEY=""
PLUNK_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# Optional alternative single-email providers (src/lib/server/mail) — not
# used by the Campaign Builder itself (that's Plunk Campaigns only, see
# README), but available for any future transactional-email use case.
# ------------------------------------------------------------------
MAIL_PROVIDER="console"
LOOPS_API_KEY=""
LOOPS_TRANSACTIONAL_ID=""
LOOPS_WEBHOOK_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
